# Local device token used by the Android debug build.
DEVICE_TOKEN=dev-token
HOST=127.0.0.1
ASSISTANT_TIME_ZONE=Asia/Shanghai

# Volcengine bidirectional streaming ASR.
VOLCENGINE_ASR_API_KEY=
VOLCENGINE_ASR_RESOURCE_ID=volc.seedasr.sauc.duration

# Natural-language intent planning.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Dangerous convenience for a dedicated developer device.
ALLOW_WECHAT_AUTOSEND=false
