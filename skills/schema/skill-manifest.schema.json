{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://personal-jarvis.local/schemas/skill-manifest.schema.json",
  "title": "小猪搭手 skill manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "version",
    "appPackages",
    "prerequisites",
    "capabilities",
    "risk",
    "verification",
    "steps"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?$"
    },
    "appPackages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z][A-Za-z0-9_]*(\\.[A-Za-z][A-Za-z0-9_]*)+$"
      }
    },
    "prerequisites": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "enum": [
          "accessibility",
          "shizuku",
          "media_session",
          "deep_link"
        ]
      }
    },
    "risk": {
      "type": "object",
      "additionalProperties": false,
      "required": ["autoSend"],
      "properties": {
        "autoSend": {
          "enum": ["unique_recipient", "confirm", "never"]
        }
      }
    },
    "verification": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
