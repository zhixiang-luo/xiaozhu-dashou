{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://personal-jarvis.local/schemas/skill-manifest.schema.json",
  "title": "小猪搭手 skill manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "version",
    "appPackages",
    "prerequisites",
    "capabilities",
    "risk",
    "verification",
    "steps"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?$"
    },
    "displayName": {
      "type": "string",
      "minLength": 1
    },
    "appPackages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z][A-Za-z0-9_]*(\\.[A-Za-z][A-Za-z0-9_]*)+$"
      }
    },
    "supportedVersions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "prerequisites": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "enum": [
          "accessibility",
          "shizuku",
          "media_session",
                  "deep_link",
                  "system_provider"
        ]
      }
    },
    "risk": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sideEffect": {
          "enum": ["none", "read", "external_communication", "payment"]
        },
        "autoSend": {
          "enum": ["unique_recipient", "confirm", "never"]
        },
        "handoffOn": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "inputs": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["type", "required"],
        "additionalProperties": false,
        "properties": {
          "type": {
            "enum": ["text", "number", "boolean"]
          },
          "required": {
            "type": "boolean"
          },
          "description": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "verification": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {
            "type": "string",
            "minLength": 1
          },
          {
            "type": "object",
            "required": ["id", "action"],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "action": {
                "enum": [
                  "open_app",
                  "restart_app",
                  "require_foreground",
                  "tap",
                  "input_text",
                  "send",
                  "extract_text",
                  "verify",
                  "media_control",
                  "create_calendar_event",
                  "list_calendar_events",
                  "update_calendar_event",
                  "delete_calendar_event",
                  "invoke_skill",
                  "wait"
                ]
              },
              "package": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9_]*(\\.[A-Za-z][A-Za-z0-9_]*)+$"
              },
              "target": {
                "$ref": "#/$defs/target"
              },
              "unique": {
                "type": "boolean"
              },
              "inputKey": {
                "type": "string",
                "minLength": 1
              },
              "outputKey": {
                "type": "string",
                "minLength": 1
              },
              "predicate": {
                "type": "string",
                "minLength": 1
              },
              "command": {
                "enum": ["play", "pause", "next", "previous"]
              },
              "skill": {
                "type": "string",
                "minLength": 1
              },
              "inputs": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                }
              },
              "durationMs": {
                "type": "integer",
                "minimum": 1,
                "maximum": 30000
              },
              "titleKey": {
                "type": "string",
                "minLength": 1
              },
              "startTimeKey": {
                "type": "string",
                "minLength": 1
              },
              "durationKey": {
                "type": "string",
                "minLength": 1
              },
              "timeZoneKey": {
                "type": "string",
                "minLength": 1
              },
              "rangeStartKey": {
                "type": "string",
                "minLength": 1
              },
              "rangeEndKey": {
                "type": "string",
                "minLength": 1
              },
              "titleQueryKey": {
                "type": "string",
                "minLength": 1
              },
              "newTitleKey": {
                "type": "string",
                "minLength": 1
              },
              "newStartTimeKey": {
                "type": "string",
                "minLength": 1
              },
              "newDurationKey": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        ]
      }
    }
  },
  "$defs": {
    "target": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1
        },
        "contentDescription": {
          "type": "string",
          "minLength": 1
        },
        "resourceId": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "type": "string",
          "minLength": 1
        },
        "fallbackPoint": {
          "$ref": "#/$defs/point"
        }
      }
    },
    "point": {
      "type": "object",
      "required": ["x", "y"],
      "additionalProperties": false,
      "properties": {
        "x": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "y": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    }
  }
}
